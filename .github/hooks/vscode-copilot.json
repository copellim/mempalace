{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "mempalace hook run --hook session-start --harness vscode-copilot"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "mempalace hook run --hook stop --harness vscode-copilot"
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "mempalace hook run --hook precompact --harness vscode-copilot"
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "mempalace hook run --hook subagent-start --harness vscode-copilot"
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "mempalace hook run --hook subagent-stop --harness vscode-copilot"
      }
    ]
  }
}

